# Copiá este archivo como ".env":   copy .env.example .env      (Linux/Mac: cp .env.example .env)
# El archivo ".env" NO se sube a GitHub (está en .gitignore).

# --- Clave de NUESTRA API ---------------------------------------------------------------------
# Ya viene cargada (es una clave de demostración para correr todo en tu propia computadora).
# API_KEYS = las claves que acepta la API (se pueden poner varias separadas por coma).
# PROVEEDORES_API_KEY = la clave que usa main.py cuando le habla a la API. Tiene que ser una de las de arriba.
API_KEYS=clave-tp-programacion2
PROVEEDORES_API_KEY=clave-tp-programacion2

# Dónde corre nuestra API (por defecto, en tu computadora)
PROVEEDORES_API_URL=http://127.0.0.1:8000

# --- Cuenta DESDE la que se envían los mails: COMPLETAR DESPUÉS ----------------------------------
# Con Gmail: SMTP_USUARIO es tu Gmail y SMTP_CLAVE una "contraseña de aplicación" de Google
# (Cuenta de Google -> Seguridad -> Verificación en 2 pasos -> Contraseñas de aplicaciones).
# NO es tu clave normal. Si quedan vacías, el programa funciona igual pero no envía el mail.
# El mail DE DESTINO no va acá: se escribe en la terminal en cada consulta.
SMTP_SERVIDOR=smtp.gmail.com
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CLAVE=

# --- Opcionales ---------------------------------------------------------------------------------
# Poner en false para desactivar el scraping del Boletín sin tocar el código
SCRAPING_HABILITADO=true

# CUIT de proveedores críticos, separados por coma y sin guiones
PROVEEDORES_CRITICOS=

# Ruta a un certificado CA si el BCRA da error de SSL en tu red
# BCRA_CA_BUNDLE=C:\ruta\al\certificado.pem
